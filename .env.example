# Get your FREE API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: models to try, in order (comma-separated). The default is a chain of current Flash models,
# so a model that is out of free daily quota or overloaded is skipped automatically.
# See https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash

# Optional: cheap models for the small classification call (default: gemini-3.5-flash-lite,gemini-3.1-flash-lite)
# GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
